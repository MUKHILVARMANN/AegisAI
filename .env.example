# ─── Database ───────────────────────────────────────────────────────────────────
POSTGRES_USER=aegisai
POSTGRES_PASSWORD=aegisai_secret
POSTGRES_DB=aegisai
DATABASE_URL=postgresql+asyncpg://aegisai:aegisai_secret@postgres:5432/aegisai

# ─── Redis ───────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ─── MinIO (Object Storage) ──────────────────────────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=aegisai-documents
MINIO_SECURE=false

# ─── LLM Provider ────────────────────────────────────────────────────────────────
# Set exactly one of: openai, gemini
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...your-key-here...
OPENAI_MODEL=gpt-4o

# Alternatively use Gemini
GEMINI_API_KEY=...your-key-here...
GEMINI_MODEL=gemini-1.5-pro

# ─── Embeddings ──────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# ─── Retrieval Parameters ────────────────────────────────────────────────────────
RETRIEVAL_TOP_N=20
RERANKER_TOP_K=5
BM25_WEIGHT=0.4
VECTOR_WEIGHT=0.6

# ─── API ─────────────────────────────────────────────────────────────────────────
# JWT signing key. The backend REFUSES to start when this is left at the
# default unless DEBUG=1. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
DEBUG=1
CORS_ORIGINS=http://localhost:3000
API_PORT=8000

# ─── Rate Limiting ───────────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
